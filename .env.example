# NZBoxer Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./nzboxer.db

# --- Simkl ---
SIMKL_CLIENT_ID=your_simkl_client_id_here
SIMKL_ACCESS_TOKEN=your_simkl_access_token_here

# --- TMDB ---
TMDB_API_KEY=your_tmdb_api_v3_key_here

# --- Treasure Maps (Newznab Indexer) ---
TREASURE_MAPS_URL=https://www.trashindexer.com
TREASURE_MAPS_API_KEY=your_newznab_api_key_here

# --- TorBox ---
TORBOX_API_KEY=your_torbox_api_key_here

# --- App Settings ---
# Set to "development" or "production"
APP_ENV=development
LOG_LEVEL=INFO
